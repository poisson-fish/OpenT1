{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "x64-debug",
      "displayName": "OpenT1 x64-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/x64-debug",
      "toolchainFile": "${sourceDir}/cmake/toolchains/msvc-x64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FETCHCONTENT_QUIET": "OFF",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "x64-release",
      "displayName": "OpenT1 x64-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/x64-release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/msvc-x64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FETCHCONTENT_QUIET": "OFF",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "headless",
      "displayName": "OpenT1 headless",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/headless",
      "toolchainFile": "${sourceDir}/cmake/toolchains/msvc-x64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "OPENT1_BUILD_PLATFORM": "OFF",
        "OPENT1_BUILD_AUDIO": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "x64-debug"
    },
    {
      "name": "x64-release",
      "configurePreset": "x64-release"
    },
    {
      "name": "headless",
      "configurePreset": "headless"
    }
  ],
  "testPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "x64-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "x64-release",
      "configurePreset": "x64-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "headless",
      "configurePreset": "headless",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
