#include <metal_stdlib>
using namespace metal;

struct Input {
    float2 position [[attribute(0)]];
    float2 uv [[attribute(1)]];
    float3 color [[attribute(2)]];
    float haze [[attribute(3)]];
    float inverseDepth [[attribute(4)]];
    float2 lightMap [[attribute(5)]];
    float opacity [[attribute(6)]];
};

struct Output {
    float4 position [[position]];
    float2 uv [[user(locn0)]];
    float3 color [[user(locn1)]];
    float haze [[user(locn2)]];
    float2 lightMap [[user(locn3)]];
    float opacity [[user(locn4)]];
};

vertex Output main0(Input v [[stage_in]], constant float4& frame [[buffer(0)]]) {
    Output o;
    float w = frame.z != 0 ? 1.0 / v.inverseDepth : 1.0;
    o.position = float4(v.position.x * 2.0 / frame.x - 1.0,
                        1.0 - v.position.y * 2.0 / frame.y,
                        v.inverseDepth / 65536.0,
                        1.0) *
                 w;
    o.uv = v.uv;
    o.color = v.color;
    o.haze = v.haze;
    o.lightMap = v.lightMap;
    o.opacity = v.opacity;
    return o;
}
